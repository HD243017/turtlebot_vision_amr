# ==========================================
# 1. ROS 2 빌드 및 워크스페이스 아티팩트 제외
# ==========================================
build/
install/
log/
COLCON_IGNORE
*.log

# ==========================================
# 2. Python 캐시 및 가상환경 제외
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# ==========================================
# 3. 비전 검사 이미지 및 대용량 가중치 파일 제외
# ==========================================
# 검사 결과 로그 이미지 저장 폴더 제외 (폴더 유지를 위해 .gitkeep만 허용)
fms_manager/logs/*
!fms_manager/logs/.gitkeep

# 최신 검사 임시 이미지 제외
latest_inspection_result.jpg

# 대용량 YOLO 가중치 파일 제외 (깃허브 용량 초과 방지)
*.onnx
*.engine

# ==========================================
# 4. OS 및 IDE 설정 파일 제외
# ==========================================
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db