# 관제 PC(우분투)용 .env 예시. 복사해서 비밀번호와 사용자이름만 고친다. (.env 는 git 에 올라가지 않는다)
#   cp .env.example .env && nano .env
# 같은 .env 를 main.py 폴더(fms_manager/)에도 복사한다. db_manager.py 는 자기 옆 .env 의 DB 다섯 줄만 읽는다.
#   cp .env ../fms_manager/.env
# 설명은 값과 다른 줄에 쓴다 (같은 줄에 쓰면 설명까지 값으로 읽힘)
FMS_DB_HOST=127.0.0.1
FMS_DB_PORT=3306
FMS_DB_NAME=fms
FMS_DB_USER=fms_app
FMS_DB_PASSWORD=정한비밀번호
# 검사 프로그램(pcb_cv_inspector3_2.py)이 있는 폴더. 검사 사진이 이 폴더의 logs/pass · logs/fail 에 쌓인다
FMS_SNAPSHOT_DIR=/home/사용자이름/turtlebot_vision_amr/fms_manager
# ROS 토픽(/fms/status) 받기 (rclpy 필요, 실행은 --no-reload)
FMS_ROS=1

# ---- 필요할 때만 (앞의 # 을 지운다) ----
# 지도를 바꿀 때 (기본 maps/map_test1.yaml + config/zones.yaml)
# FMS_MAP=maps/map_test1.yaml
# FMS_ZONES=config/zones.yaml
